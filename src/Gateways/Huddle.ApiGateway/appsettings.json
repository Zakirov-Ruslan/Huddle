{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "channel": {
        "ClusterId": "channel-cluster",
        "Match": {
          "Path": "/channel/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/channel" }
        ]
      },
      "voice": {
        "ClusterId": "voice-cluster",
        "Match": {
          "Path": "/voice/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/voice" }
        ]
      },
      "signalR": {
        "ClusterId": "signalR-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/notifications" }
        ],
        "AllowWebSockets": true
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "https://localhost:7285"
          }
        }
      },
      "channel-cluster": {
        "Destinations": {
          "channel-destination": {
            "Address": "https://localhost:7115"
          }
        }
      },
      "voice-cluster": {
        "Destinations": {
          "voice-destination": {
            "Address": "https://localhost:7121"
          }
        }
      },
      "signalR-cluster": {
        "Destinations": {
          "signalR-destination": {
            "Address": "https://localhost:7164"
          }
        }
      }
    }
  }
}